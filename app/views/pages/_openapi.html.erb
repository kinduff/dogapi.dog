<%# page_heading below sets both the <title> and the <h1>. %>
<% content_for :main_class, "wide" %>
<% content_for :javascripts do %>
  <%= javascript_include_tag "api_docs", defer: true %>
<% end %>

<%= page_heading "#{document.title} - Docs",
      title: "#{document.title} Reference - Parameters, Responses and Examples" %>
<% content_for :description do %>
  Every <%= document.version %> endpoint of the free Dog API, with its
  parameters, its responses and a request you can run from the page.
<% end %>
<% breadcrumb_structured_data([["API Docs", docs_path], [document.title, request.path]]) %>

<%= api_text document.summary %>

<dl class="api-facts">
  <dt>Base URL</dt>
  <dd><code><%= document.base_url %></code></dd>

  <dt>Auth</dt>
  <dd>None. No key, no sign up — just send the request.</dd>

  <dt>Returns</dt>
  <dd>JSON<%= ", following the JSON:API convention" if document.models.any? %>.</dd>

  <dt>OpenAPI</dt>
  <dd><%= link_to document.document_path, document.document_path %></dd>

  <% if document.license %>
    <dt>License</dt>
    <dd><%= link_to document.license["name"], document.license["url"] %></dd>
  <% end %>

  <% if document.contact_email %>
    <dt>Questions</dt>
    <dd><%= mail_to document.contact_email %></dd>
  <% end %>
</dl>

<%= render "pages/openapi_quickstart", document: document %>

<h2 id="endpoints">
  <a class="api-anchor" href="#endpoints" aria-hidden="true"></a>
  Endpoints
</h2>

<p>
  Every endpoint below can be run straight from this page — fill in the fields
  and press <em>Send request</em>. The examples show what comes back.
</p>

<nav class="api-toc" aria-label="Endpoints">
  <% document.sections.each do |section| %>
    <div class="api-toc-group">
      <strong><%= section[:name] %></strong>
      <ul>
        <% section[:operations].each do |operation| %>
          <li>
            <a href="#<%= operation.anchor %>">
              <span class="<%= api_method_class operation.verb %>"><%= operation.verb %></span>
              <code><%= operation.path %></code>
            </a>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if document.models.any? %>
    <div class="api-toc-group">
      <strong>Reference</strong>
      <ul>
        <% document.models.each do |model| %>
          <li><a href="#<%= document.anchor_for_model(model) %>"><code><%= model %></code></a></li>
        <% end %>
      </ul>
    </div>
  <% end %>
</nav>

<% document.sections.each do |section| %>
  <section class="api-section">
    <h2 id="tag-<%= section[:name].parameterize %>">
      <a class="api-anchor" href="#tag-<%= section[:name].parameterize %>" aria-hidden="true"></a>
      <%= section[:name] %>
    </h2>

    <%= api_text section[:description] %>

    <% section[:operations].each do |operation| %>
      <%= render "pages/openapi_operation", document: document, operation: operation %>
    <% end %>
  </section>
<% end %>

<% if document.models.any? %>
  <section class="api-section">
    <h2 id="models">
      <a class="api-anchor" href="#models" aria-hidden="true"></a>
      Object reference
    </h2>

    <p>
      The objects the responses are built from. <code>Breed</code>,
      <code>Group</code> and <code>Fact</code> are the things themselves;
      <code>Range</code> and <code>PaginationMeta</code> are small helpers that
      show up inside them.
    </p>

    <% document.models.each do |model| %>
      <h3 id="<%= document.anchor_for_model(model) %>">
        <a class="api-anchor" href="#<%= document.anchor_for_model(model) %>" aria-hidden="true"></a>
        <code><%= model %></code>
      </h3>

      <%= render "pages/openapi_fields", document: document, fields: document.model_fields(model) %>
    <% end %>
  </section>
<% end %>
