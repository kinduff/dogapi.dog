<%#
  One demo section: a short explanation, a live request panel built from the
  same markup the reference uses, and the equivalent code to copy.
%>
<% anchor = title.parameterize %>
<% params = local_assigns.fetch(:params, []) %>

<section class="api-operation">
  <h3 id="<%= anchor %>">
    <a class="api-anchor" href="#<%= anchor %>" aria-hidden="true"></a>
    <span class="api-method api-method-get">GET</span>
    <code class="api-path"><%= path_label %></code>
  </h3>

  <p><%= intro %></p>

  <form class="api-try" data-api-try data-base="<%= base %>" data-path="<%= path %>">
    <fieldset>
      <legend>Try it</legend>

      <% if params.any? %>
        <div class="api-try-fields">
          <% params.each do |param| %>
            <% field_id = "#{anchor}-#{param[:name].parameterize}" %>
            <div class="api-try-field">
              <label for="<%= field_id %>"><%= param[:name] %></label>
              <input type="text"
                     id="<%= field_id %>"
                     data-param="<%= param[:name] %>"
                     data-in="<%= param.fetch(:in, "query") %>"
                     data-default="<%= param[:default] %>"
                     value="<%= param[:default] %>"
                     placeholder="<%= param[:hint] %>">
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="api-try-actions">
        <button type="submit" class="api-button">Send request</button>
        <button type="button" class="api-button api-button-quiet" data-api-reset>Reset</button>
        <span class="api-muted">Runs against this site.</span>
      </div>
    </fieldset>

    <div class="api-try-output" data-api-output hidden>
      <figure class="code">
        <figcaption class="code-head">
          <span class="api-status" data-api-status></span>
          <code class="api-try-url" data-api-url></code>
        </figcaption>
        <pre class="code-body code-body-tall"><code data-api-body></code></pre>
      </figure>
    </div>
  </form>

  <%= render "pages/api_code",
        label: "The same request in JavaScript",
        language: "javascript",
        id: "#{anchor}-snippet",
        content: snippet %>
</section>
