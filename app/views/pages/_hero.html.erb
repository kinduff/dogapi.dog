<%# The top of the page is one request to the public API, rendered. The eight
    breeds below are the page of the collection named in the URL under them,
    in the same order, and the shuffle button asks for another page. Without
    JavaScript it is a grid of real dogs that link to their pages. %>
<% query = {"filter[has_images]" => "true", "page[size]" => size, "page[number]" => page} %>
<section class="home-hero" data-hero data-hero-pages="<%= pages %>" data-hero-size="<%= size %>"
         data-hero-page="<%= page %>">
  <ul class="home-hero-grid" data-hero-grid>
    <% breeds.each do |breed| %>
      <li class="home-hero-card">
        <a href="<%= breed_path_for(breed) %>">
          <img src="<%= breed.breed_images.first.url_for(:medium) %>"
               srcset="<%= breed.breed_images.first.url_for(:thumb) %> 200w, <%= breed.breed_images.first.url_for(:medium) %> 600w"
               sizes="(max-width: 600px) 45vw, 15rem"
               alt="A <%= breed.name %>" width="600" height="600" loading="eager">
          <strong><%= breed.name %></strong>
          <span class="api-muted"><%= hero_meta(breed) %></span>
        </a>
      </li>
    <% end %>
  </ul>

  <p class="home-hero-request">
    <span class="home-hero-url">
      <span class="api-method api-method-get">GET</span>
      <code data-hero-url><%= api_url("/breeds", query) %></code>
    </span>

    <%# Nothing to press until the script is there to answer it. %>
    <button type="button" class="api-button" data-hero-shuffle hidden>Another page</button>
    <span class="home-hero-spinner" data-hero-spinner hidden aria-hidden="true"></span>
  </p>
</section>
