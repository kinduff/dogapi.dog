<%# A grid of real dogs at the top of the page. Each square links to the breed
    it shows. Nothing to press and nothing to load after the pictures. %>
<section class="home-hero">
  <ul class="home-hero-grid">
    <% breeds.each_with_index do |breed, index| %>
      <li class="home-hero-card">
        <a href="<%= breed_path_for(breed) %>" title="<%= breed.name %>">
          <img src="<%= breed.breed_images.first.url_for(:medium) %>"
               srcset="<%= breed.breed_images.first.url_for(:thumb) %> 200w, <%= breed.breed_images.first.url_for(:medium) %> 600w"
               sizes="(max-width: 600px) 30vw, 10rem"
               alt="A <%= breed.name %>" width="600" height="600"
               loading="<%= index < 6 ? "eager" : "lazy" %>"
               <%# The top left square is the largest thing above the fold, so
                   it goes ahead of the rest of the row. %>
               <%= 'fetchpriority="high"'.html_safe if index.zero? %>>
        </a>
      </li>
    <% end %>
  </ul>
</section>
