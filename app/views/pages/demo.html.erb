<% page_heading "Demo" %>
<% content_for :main_class, "wide" %>
<% content_for :javascripts do %>
  <%= javascript_include_tag "api_docs", defer: true %>
<% end %>

<p>
  Every endpoint, live. Change the values, send the request, and read what comes
  back — then copy the equivalent JavaScript into your own project. The full
  reference lives in the <%= link_to "API docs", docs_path %>.
</p>

<p class="api-note">
  Requests run against this site, so what you see here is exactly what your code
  will get. Nothing is stored and no key is needed.
</p>

<h2 id="v1">
  <a class="api-anchor" href="#v1" aria-hidden="true"></a>
  Version 1 <span class="api-muted">(deprecated)</span>
</h2>

<p>
  The original API. It answers with a plain <code>{ facts: [...] }</code> object,
  or with bare text when you ask for <code>raw</code>. New projects should use
  version 2 below.
</p>

<%= render "pages/demo_endpoint",
      title: "v1 facts",
      path_label: "/api/v1/facts",
      base: "/api/v1",
      path: "/facts",
      intro: "Random dog facts. Ask for up to five at a time; anything larger comes back as five.",
      params: [
        {name: "number", default: "2", hint: "1-5"},
        {name: "raw", default: "", hint: "true for plain text"}
      ],
      snippet: <<~JS.strip %>
        // Two facts as JSON
        const response = await fetch(
          "https://dogapi.dog/api/v1/facts?number=2"
        );
        const body = await response.json();

        console.log(body.facts);

        // One fact as plain text
        const raw = await fetch(
          "https://dogapi.dog/api/v1/facts?raw=true"
        );

        console.log(await raw.text());
      JS

<h2 id="v2">
  <a class="api-anchor" href="#v2" aria-hidden="true"></a>
  Version 2
</h2>

<p>
  The current API. Responses follow JSON:API, so every record arrives with an
  <code>id</code>, a <code>type</code> and an <code>attributes</code> object.
</p>

<%= render "pages/demo_endpoint",
      title: "v2 facts",
      path_label: "/api/v2/facts",
      base: "/api/v2",
      path: "/facts",
      intro: "The same random facts, wrapped in the JSON:API envelope.",
      params: [{name: "limit", default: "2", hint: "1-5"}],
      snippet: <<~JS.strip %>
        const response = await fetch(
          "https://dogapi.dog/api/v2/facts?limit=2"
        );
        const body = await response.json();

        body.data.forEach((fact) => {
          console.log(fact.attributes.body);
        });
      JS

<%= render "pages/demo_endpoint",
      title: "v2 breeds",
      path_label: "/api/v2/breeds",
      base: "/api/v2",
      path: "/breeds",
      intro: "Every breed, paginated. Leave the page size empty to get all of them at once, or set it low while you are exploring.",
      params: [
        {name: "page[size]", default: "3", hint: "1-1000"},
        {name: "page[number]", default: "", hint: "1 and up"}
      ],
      snippet: <<~JS.strip %>
        const response = await fetch(
          "https://dogapi.dog/api/v2/breeds?page[size]=10"
        );
        const body = await response.json();

        body.data.forEach((breed) => {
          console.log(breed.attributes.name);
        });

        // How many are there in total?
        console.log(body.meta.pagination.records);
      JS

<%= render "pages/demo_endpoint",
      title: "one breed",
      path_label: "/api/v2/breeds/{id}",
      base: "/api/v2",
      path: "/breeds/{id}",
      intro: "A single breed by id. Copy an id from the breeds response above and paste it here.",
      params: [{name: "id", in: "path", default: "", hint: "a breed id"}],
      snippet: <<~JS.strip %>
        const id = "68f47c5a-5115-47cd-9849-e45d3c378f12";
        const response = await fetch(
          `https://dogapi.dog/api/v2/breeds/${id}`
        );
        const body = await response.json();
        const breed = body.data.attributes;

        console.log(breed.name);
        console.log(`Lives ${breed.life.min}-${breed.life.max} years`);
      JS

<%= render "pages/demo_endpoint",
      title: "v2 groups",
      path_label: "/api/v2/groups",
      base: "/api/v2",
      path: "/groups",
      intro: "The breed groups. Each one lists the ids of the breeds it contains.",
      snippet: <<~JS.strip %>
        const response = await fetch("https://dogapi.dog/api/v2/groups");
        const body = await response.json();

        body.data.forEach((group) => {
          const breeds = group.relationships.breeds.data.length;

          console.log(`${group.attributes.name}: ${breeds} breeds`);
        });
      JS

<%= render "pages/demo_endpoint",
      title: "one group",
      path_label: "/api/v2/groups/{id}",
      base: "/api/v2",
      path: "/groups/{id}",
      intro: "A single group by id, taken from the groups response above.",
      params: [{name: "id", in: "path", default: "", hint: "a group id"}],
      snippet: <<~JS.strip %>
        const id = "31f2682c-7c1e-4a4b-b7e6-c9e2e0c50dfd";
        const response = await fetch(
          `https://dogapi.dog/api/v2/groups/${id}`
        );
        const body = await response.json();

        console.log(body.data.attributes.name);
        console.log(body.data.relationships.breeds.data);
      JS
