<% page_heading @breed.name %>
<% content_for :description do %><%= breed_meta_description(@breed) %><% end %>
<% content_for :canonical_path, breed_path_for(@breed) %>
<% content_for :og_type, "article" %>
<% if (hero = @breed.breed_images.first) %>
  <% content_for :og_image, hero.url_for(:large) %>
<% end %>
<% structured_data breed_structured_data(@breed) %>

<%# The breed name carries the page, so it reads as the title and the group it
    belongs to sits under it as a subtitle. %>
<div class="breed-title">
  <h2><%= @breed.name %></h2>
  <p class="breed-subtitle">
    <%= link_to @breed.group.name, group_path_for(@breed.group) %>
    <%= "· Hypoallergenic" if @breed.hypoallergenic %>
  </p>
</div>

<% images = @breed.breed_images.to_a %>
<% if images.any? %>
  <% content_for :javascripts do %>
    <%= javascript_include_tag "breed_gallery", defer: true %>
  <% end %>

  <figure class="breed-hero" data-gallery>
    <a href="<%= images.first.url_for %>" target="_blank" rel="noopener" data-gallery-link>
      <img src="<%= images.first.url_for(:large) %>" alt="<%= @breed.name %>"
           width="1200" height="1200" loading="eager" data-gallery-hero>
    </a>

    <%# One caption per image, server rendered so the licence links stay intact.
        The script shows the one belonging to the picture on display. %>
    <% images.each_with_index do |image, index| %>
      <figcaption class="api-muted" data-gallery-credit="<%= image.id %>" <%= "hidden" unless index.zero? %>>
        <%= image.author.presence || "Unknown author" %> ·
        <% if image.license_url.present? %>
          <%= link_to image.license, image.license_url, target: "_blank", rel: "noopener nofollow" %>
        <% else %>
          <%= image.license %>
        <% end %>
        · <%= link_to "source", image.attribution[:source_url], target: "_blank", rel: "noopener nofollow" %>
      </figcaption>
    <% end %>
  </figure>

  <% if images.size > 1 %>
    <ul class="breed-gallery">
      <% images.each_with_index do |image, index| %>
        <li>
          <%# Without the script these stay what they look like: links to the
              file. With it, they swap the picture above instead. %>
          <a href="<%= image.url_for %>" target="_blank" rel="noopener"
             title="<%= image_credit(image) %>"
             class="<%= "is-current" if index.zero? %>"
             data-gallery-item
             data-image-id="<%= image.id %>"
             data-large="<%= image.url_for(:large) %>">
            <img src="<%= image.url_for(:thumb) %>" alt="<%= @breed.name %>"
                 width="200" height="200" loading="lazy">
          </a>
        </li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <p class="api-note">
    No picture for this breed yet. Images are imported from Wikimedia Commons,
    and this one has not turned up a usable photo.
  </p>
<% end %>

<dl class="api-facts">
  <dt>Group</dt>
  <dd><%= link_to @breed.group.name, group_path_for(@breed.group) %></dd>

  <% if (life = breed_life_span(@breed)) %>
    <dt>Life span</dt>
    <dd><%= life %></dd>
  <% end %>

  <% if (weight = breed_weight(@breed, :male)) %>
    <dt>Male weight</dt>
    <dd><%= weight %></dd>
  <% end %>

  <% if (weight = breed_weight(@breed, :female)) %>
    <dt>Female weight</dt>
    <dd><%= weight %></dd>
  <% end %>

  <dt>Hypoallergenic</dt>
  <dd><%= @breed.hypoallergenic ? "Yes" : "No" %></dd>

  <dt>Id</dt>
  <dd><code><%= @breed.id %></code></dd>
</dl>

<% if @breed.description.present? %>
  <p><%= @breed.description %></p>
<% end %>

<% if @siblings.any? %>
  <h2 id="group">
    <a class="api-anchor" href="#group" aria-hidden="true"></a>
    More from the <%= @breed.group.name %>
  </h2>

  <ul class="breed-grid">
    <%= render partial: "shared/breed_card", collection: @siblings, as: :breed %>
  </ul>

  <p><%= link_to "Every breed in this group →", group_path_for(@breed.group) %></p>
<% end %>

<%= render "shared/api_panel",
      anchor: "get-breeds-id",
      url: api_url("/breeds/#{@breed.id}"),
      payload: api_payload(@breed, BreedSerializer) %>

<p class="api-muted">
  The picture itself also has an endpoint:
  <code><%= api_url("/breeds/#{@breed.id}/image") %></code>, which redirects
  straight to the file. <%= link_to "See it in the reference", api_docs_url("get-breeds-id-image") %>.
</p>
