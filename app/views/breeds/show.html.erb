<% content_for :title, "#{@breed.name} Dog Breed - Size, Life Span and Pictures" %>
<% content_for :description do %><%= breed_meta_description(@breed) %><% end %>
<% content_for :canonical_path, breed_path_for(@breed) %>
<% content_for :og_type, "article" %>
<% if (hero = @breed.breed_images.first) %>
  <% content_for :og_image, hero.url_for(:large) %>
<% end %>
<% structured_data breed_structured_data(@breed) %>
<% breadcrumb_structured_data([["Dog Breeds", breeds_path], [@breed.name, breed_path_for(@breed)]]) %>

<%# The breed name carries the page, so it reads as the heading and the group
    it belongs to sits under it as a subtitle. %>
<div class="breed-title">
  <h1><%= @breed.name %></h1>
  <p class="breed-subtitle">
    <%= link_to @breed.group.name, group_path_for(@breed.group) %>
    <%= "· Hypoallergenic" if @breed.hypoallergenic %>
  </p>
</div>

<% images = @breed.breed_images.to_a %>
<% if images.any? %>
  <% content_for :javascripts do %>
    <%= javascript_include_tag "breed_gallery", defer: true %>
  <% end %>

  <figure class="breed-hero" data-gallery>
    <a href="<%= images.first.url_for %>" target="_blank" rel="noopener" data-gallery-link>
      <%# The picture the page is largely about, so it is fetched ahead of
          everything else competing for the connection. %>
      <img src="<%= images.first.url_for(:large) %>" alt="<%= @breed.name %> dog, photographed by <%= images.first.author.presence || "an unknown author" %>"
           width="1200" height="1200" loading="eager" fetchpriority="high" data-gallery-hero>
    </a>

    <%# One caption per image, server rendered so the licence links stay intact.
        The script shows the one belonging to the picture on display. %>
    <% images.each_with_index do |image, index| %>
      <figcaption class="api-muted" data-gallery-credit="<%= image.id %>" <%= "hidden" unless index.zero? %>>
        <%= image.author.presence || "Unknown author" %> ·
        <% if image.license_url.present? %>
          <%= link_to image.license, image.license_url, target: "_blank", rel: "noopener nofollow" %>
        <% else %>
          <%= image.license %>
        <% end %>
        · <%= link_to "source", image.attribution[:source_url], target: "_blank", rel: "noopener nofollow" %>
      </figcaption>
    <% end %>
  </figure>

  <% if images.size > 1 %>
    <ul class="breed-gallery">
      <% images.each_with_index do |image, index| %>
        <li>
          <%# Without the script these stay what they look like: links to the
              file. With it, they swap the picture above instead. %>
          <a href="<%= image.url_for %>" target="_blank" rel="noopener"
             title="<%= image_credit(image) %>"
             class="<%= "is-current" if index.zero? %>"
             data-gallery-item
             data-image-id="<%= image.id %>"
             data-large="<%= image.url_for(:large) %>">
            <%# Numbered, so a screen reader announcing the row says which one
                of them it is on rather than the same name six times. %>
            <img src="<%= image.url_for(:thumb) %>" alt="<%= @breed.name %>, picture <%= index + 1 %> of <%= images.size %>"
                 width="200" height="200" loading="lazy">
          </a>
        </li>
      <% end %>
    </ul>
  <% end %>
<% else %>
  <p class="api-note">
    No picture for this breed yet. Images are imported from Wikimedia Commons,
    and this one has not turned up a usable photo.
  </p>
<% end %>

<%# The measurements first and as cards: they are what most visitors opened
    the page for, and they read badly as rows of a table. %>
<% stats = breed_stats(@breed) %>
<% if stats.any? %>
  <ul class="breed-stats">
    <% stats.each do |stat| %>
      <li class="breed-stat">
        <span class="breed-stat-icon"><%= icon(stat[:icon]) %></span>
        <span class="breed-stat-label"><%= stat[:label] %></span>
        <% stat[:rows].each do |row| %>
          <span class="breed-stat-value">
            <% if row[:sex] %>
              <%= icon(row[:sex], label: (row[:sex] == :mars) ? "Male" : "Female") %>
            <% end %>
            <%= row[:value] %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if @breed.traits_temperament.present? %>
  <ul class="breed-tags">
    <% @breed.traits_temperament.each do |trait| %>
      <li><%= trait %></li>
    <% end %>
  </ul>
<% end %>

<% if @breed.description.present? %>
  <p class="breed-lead"><%= @breed.description %></p>
<% end %>

<dl class="api-facts">
  <dt>Group</dt>
  <dd><%= link_to @breed.group.name, group_path_for(@breed.group) %></dd>

  <% if (origin = breed_origin(@breed)) %>
    <dt>Origin</dt>
    <dd><%= origin %></dd>
  <% end %>

  <% if (coat = breed_coat(@breed)) %>
    <dt>Coat</dt>
    <dd><%= coat %></dd>
  <% end %>

  <% if @breed.other_names.any? %>
    <dt>Also known as</dt>
    <dd><%= @breed.other_names.to_sentence %></dd>
  <% end %>

  <% if @breed.recognized_by.any? %>
    <dt>Recognized by</dt>
    <dd><%= @breed.recognized_by.join(", ") %></dd>
  <% end %>

  <dt>Hypoallergenic</dt>
  <dd><%= @breed.hypoallergenic ? "Yes" : "No" %></dd>

  <dt>Id</dt>
  <dd><code><%= @breed.id %></code></dd>
</dl>

<%# Ratings are estimates researched from breed standards, so they are shown
    together with where they came from rather than as bare facts. %>
<% ratings = breed_ratings(@breed) %>
<% if ratings.any? %>
  <h2 id="traits">
    <a class="api-anchor" href="#traits" aria-hidden="true"></a>
    Traits
  </h2>

  <ul class="breed-traits">
    <% ratings.each do |label, value| %>
      <li>
        <span class="breed-trait-label"><%= label %></span>
        <span class="breed-trait-bar" role="img" aria-label="<%= label %>: <%= value %> out of 5">
          <% breed_rating_segments(value).each do |filled| %>
            <span class="<%= "is-filled" if filled %>"></span>
          <% end %>
        </span>
      </li>
    <% end %>
  </ul>

  <p class="api-muted breed-scale">
    Every rating runs from 1 to 5 against dogs in general, so a 3 is an average
    dog rather than an average <%= @breed.name %>. They are researched
    estimates, not measurements.
  </p>
<% end %>

<% if @breed.sources.any? %>
  <p class="breed-sources">
    <span>Researched from</span>
    <% @breed.sources.each do |source| %>
      <%= link_to breed_source_label(source), source["url"], title: source["title"],
            class: "breed-chip", target: "_blank", rel: "noopener nofollow" %>
    <% end %>
  </p>
<% end %>

<% if @siblings.any? %>
  <h2 id="group">
    <a class="api-anchor" href="#group" aria-hidden="true"></a>
    More from the <%= @breed.group.name %>
  </h2>

  <ul class="breed-grid">
    <%= render partial: "shared/breed_card", collection: @siblings, as: :breed %>
  </ul>

  <p><%= link_to "Every breed in this group →", group_path_for(@breed.group) %></p>
<% end %>

<%= render "shared/api_panel",
      anchor: "get-breeds-id",
      url: api_url("/breeds/#{@breed.id}"),
      payload: api_payload(@breed, BreedSerializer) %>

<p class="api-muted">
  The picture itself also has an endpoint:
  <code><%= api_url("/breeds/#{@breed.id}/image") %></code>, which redirects
  straight to the file. <%= link_to "See it in the reference", api_docs_url("get-breeds-id-image") %>.
</p>
