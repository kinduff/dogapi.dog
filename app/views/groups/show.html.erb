<%= page_heading @group.name, title: "#{@group.name} - #{@breeds.size} Dog Breeds with Pictures" %>
<% content_for :description do %>
  The <%= @breeds.size %> dog breeds in the <%= @group.name %>, with pictures,
  life spans and weights, from the free Dog API.
<% end %>
<% content_for :canonical_path, group_path_for(@group) %>
<% structured_data group_structured_data(@group, @breeds) %>
<% breadcrumb_structured_data([["Breed Groups", groups_path], [@group.name, group_path_for(@group)]]) %>

<p>
  <%= pluralize @breeds.size, "breed" %> in the <%= @group.name %>.
  <%= link_to "All groups", groups_path %>.
</p>

<% if @breeds.any? %>
  <ul class="breed-grid">
    <%= render partial: "shared/breed_card", collection: @breeds, as: :breed %>
  </ul>
<% else %>
  <p class="api-note">No breeds in this group yet.</p>
<% end %>

<%= render "shared/api_panel",
      anchor: "get-groups-id",
      url: api_url("/groups/#{@group.id}"),
      payload: api_payload(@group, GroupSerializer) %>
