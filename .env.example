# Copy to .env and fill in. Never commit the real values.
#
# Umami analytics. Tracking is disabled unless UMAMI_USERNAME and
# UMAMI_PASSWORD are both set (see config/initializers/umami.rb).
UMAMI_URI_BASE=
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_WEBSITE_ID=

# Breed image storage. Leave ACTIVE_STORAGE_SERVICE unset to keep files on the
# local disk. Set it to "amazon" (S3) or "cloudflare" (R2) to use a bucket, in
# which case every S3_* value below is required.
ACTIVE_STORAGE_SERVICE=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 only: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# Public host the API hands out for image URLs, when the bucket sits behind a
# CDN or custom domain. Unset means the bucket's own URL is used.
S3_PUBLIC_HOST=

# Contact URL sent in the User-Agent when importing images from Wikimedia
# Commons. Their API policy requires an identifiable agent.
IMAGE_IMPORT_CONTACT=
