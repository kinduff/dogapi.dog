# Copy to .env and fill in. Never commit the real values.
#
# Umami analytics. Tracking is disabled unless UMAMI_USERNAME and
# UMAMI_PASSWORD are both set (see config/initializers/umami.rb).
UMAMI_URI_BASE=
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_WEBSITE_ID=

# Breed image storage. Leave ACTIVE_STORAGE_SERVICE unset to keep files on the
# local disk. Set it to "backblaze" (B2), "amazon" (S3) or "cloudflare" (R2) to
# use a bucket, in which case every S3_* value below is required. This one is
# read in production only.
ACTIVE_STORAGE_SERVICE=backblaze
# Development ignores the setting above and writes to the local disk, so an
# import run on a laptop cannot touch the live bucket. Set this to "backblaze"
# for the times you do want development to use it.
DEV_ACTIVE_STORAGE_SERVICE=
S3_BUCKET=dog-api
# The region is the middle part of the endpoint the bucket page shows.
S3_REGION=eu-central-003
# B2: https://s3.<region>.backblazeb2.com
# R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# B2 application key, from Application Keys in the console. Scope it to the
# bucket with read and write access. The secret is only shown once.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public host the API hands out for image URLs, when the bucket sits behind a
# CDN or custom domain. Unset means the bucket's own URL is used.
S3_PUBLIC_HOST=

# Host used for image URLs built outside a request, by the import tasks. Only
# matters while files are on local disk; bucket URLs carry their own host.
APP_PROTOCOL=https
APP_HOST=dogapi.dog

# Contact URL sent in the User-Agent when importing images from Wikimedia
# Commons. Their API policy requires an identifiable agent.
IMAGE_IMPORT_CONTACT=https://dogapi.dog

# The model that scores breed pictures, and how long to wait between pictures
# when a long run starts hitting rate limits. Scoring needs ANTHROPIC_API_KEY.
IMAGE_REVIEW_MODEL=claude-opus-5
IMAGE_REVIEW_DELAY=0
